# Database
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/architectureai?retryWrites=true&w=majority"

# Admin Authentication
# Used to access /admin and the admin API endpoints (sent in the x-admin-token header only).
# If this is empty the admin API refuses every request.
ADMIN_PASSWORD="change_this_admin_password"

# Signs the short-lived token that links the three form steps. Falls back to ADMIN_PASSWORD.
# Use a long random string in production, for example: openssl rand -hex 32
SIGNUP_TOKEN_SECRET=""

# Resend Email Service (optional for local testing; emails are skipped when unset)
RESEND_API_KEY=""
# Sender address on a domain verified in Resend
EMAIL_FROM="hello@architectureai.tech"
# Where new-signup notifications are sent
ADMIN_EMAIL="you@architectureai.tech"

# Public site
NEXT_PUBLIC_URL="http://localhost:3000"

# Optional
# Shown in the footer and privacy notice
NEXT_PUBLIC_CONTACT_EMAIL=""
# Shows a "Book a conversation" button to testing partners after signup
NEXT_PUBLIC_BOOKING_URL=""
# Plausible analytics (cookieless). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
